{% if page.parent.header.show_sidebar is defined %}
  {% set show_sidebar = page.parent.header.show_sidebar %}
{% else %}
  {% set show_sidebar = true %}
{% endif %}

{% embed 'partials/base.html.twig' %}

    {% block content %}
        {# the blog's address, so the post's tag links open its blog's list; kept separate from base_url,
           which the site name in the NavBar uses to link to the home page - hibbittsdesign.org #}
        {% set blog_base_url = page.parent.url %}
        {% if blog_base_url == '/' %}
          {% set blog_base_url = '' %}
        {% endif %}

        <div class="main-content">
            <div class="container">
                <div class="row">
                    {# check content display flag - hibbittsdesign.org #}
                    {% if not embedded_mode and not(theme_var('chromeless.enabled')) and (show_sidebar) %}
                      <div class="col-md-8 blog-main" role="main">
                    {% else %}
                      <div class="col-md-12 blog-main" role="main">
                    {% endif %}
                        {# no breadcrumbs if summary only flag - hibbittsdesign.org #}
                        {% if config.plugins.breadcrumbs.enabled %}
                            {% include 'partials/breadcrumbs.html.twig' %}
                        {% endif %}

                        {% include 'partials/blog_item.html.twig' with {'blog':page.parent, 'truncate':false, 'big_header':false, 'base_url':blog_base_url} %}
                    </div>

                    {# check content display flag - hibbittsdesign.org #}
                    {% if not embedded_mode and not(theme_var('chromeless.enabled')) and (show_sidebar) %}
                      <div class="col-md-4 blog-sidebar">
                          {% include 'partials/sidebar.html.twig' with {'blog':page.parent} %}
                      </div>
                    {% endif %}

                </div>
            </div>
        </div>
    {% endblock %}

{% endembed %}
