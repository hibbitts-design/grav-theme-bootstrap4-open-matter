{% if theme_var('git_sync_repo_link') %}
  {% set gitrepothemeeditlinkurl = theme_var('git_sync_repo_link') ~ '/themes/' ~ config.system.pages.theme ~ '/' %}
  {% set git_repo_link_url = theme_var('git_sync_repo_link') %}
  {% if theme_var('custom_git_sync_repo_link_icon') is empty %}
    {% if 'github' in git_repo_link_url %}
      {% set git_repo_link_icon = "github" %}
    {% elseif 'gitlab' in git_repo_link_url %}
      {% set git_repo_link_icon = "gitlab" %}
    {% elseif 'bitbucket' in git_repo_link_url %}
      {% set git_repo_link_icon = "bitbucket" %}
    {% else %}
      {% set git_repo_link_icon = "git" %}
    {% endif %}
  {% else %}
    {% set git_repo_link_icon = theme_var('custom_git_sync_repo_link_icon') %}
  {% endif %}
  <a class="newwindow external-link" href="{{ gitrepothemeeditlinkurl }}" title="{{ theme_var('git_sync.edit_theme_link_text') }}">
  <i class="fa fa-{{ git_repo_link_icon }}" aria-hidden="true"></i>{{ theme_var('git_sync.edit_theme_link_text') }}</a><br>
{% else %}
  {# Without a link set in the theme options, the link comes from the Git Sync plugin: no link when the plugin
     is turned off (or not installed) or has no repository yet,
     and otherwise a link to the theme files in the repository - hibbittsdesign.org #}
  {% if not config.plugins['git-sync'].enabled %}
    {# Git Sync is turned off: no link #}
  {% elseif config.plugins['git-sync'].repository is empty %}
    {# Git Sync is on but not connected to a repository yet: no link, so visitors don't see
       an unfinished setup step (it's set up in Admin → Plugins → Git Sync) #}
  {% else %}
    {% set git_sync_repo_link = config.plugins['git-sync'].repository %}
    {% set git_sync_branch = config.plugins['git-sync'].remote.branch ?: 'master' %}
    {% if 'github' in git_sync_repo_link %}
      {% set git_repo_link_icon = "github" %}
      {% set gitrepothemeeditlinkurl = (git_sync_repo_link|regex_replace('#([.]git)?/?$#', '')) ~ '/blob/' ~ git_sync_branch ~ '/themes/' ~ config.system.pages.theme ~ '/' %}
    {% elseif 'gitlab' in git_sync_repo_link %}
      {% set git_repo_link_icon = "gitlab" %}
      {% set gitrepothemeeditlinkurl = (git_sync_repo_link|regex_replace('#([.]git)?/?$#', '')) ~ '/blob/' ~ git_sync_branch ~ '/themes/' ~ config.system.pages.theme ~ '/' %}
    {% elseif 'bitbucket' in git_sync_repo_link %}
      {% set git_repo_link_icon = "bitbucket" %}
      {% set gitrepothemeeditlinkurl = (git_sync_repo_link|regex_replace('#([.]git)?/?$#', '')) ~ '/src/' ~ git_sync_branch ~ '/themes/' ~ config.system.pages.theme ~ '/' %}
    {% else %}
      {% set git_repo_link_icon = "git" %}
      {% set gitrepothemeeditlinkurl = (git_sync_repo_link|regex_replace('#([.]git)?/?$#', '')) ~ '/blob/' ~ git_sync_branch ~ '/themes/' ~ config.system.pages.theme ~ '/' %}
    {% endif %}
    {% if theme_var('custom_git_sync_repo_link_icon') %}
      {% set git_repo_link_icon = theme_var('custom_git_sync_repo_link_icon') %}
    {% endif %}
    <a class="newwindow external-link" href="{{ gitrepothemeeditlinkurl }}" title="{{ theme_var('git_sync.edit_theme_link_text') }}">
    <i class="fa fa-{{ git_repo_link_icon }}" aria-hidden="true"></i>{{ theme_var('git_sync.edit_theme_link_text') }}</a><br>
  {% endif %}
{% endif %}
