{% set arrayofpath = uri.path|split('/') %}
{% set firstfolderofpath = arrayofpath[1] %}
{% set secondfolderofpath = arrayofpath[2] %}

{# MultiCourse hub compatibility - hibbittsdesign.org #}
{% if page.find('/' ~ firstfolderofpath).template == 'course' or page.find('/' ~ firstfolderofpath).template == 'subsite' %}
  {% if firstfolderofpath %}
    {% set favicon = page.find('/' ~ firstfolderofpath ~ '/favicon' ).media.images|first %}
    {% set site_title = page.find('/' ~ firstfolderofpath ).title %}
  {% else %}
    {% set site_title = site.title|e('html') %}
  {% endif %}
  {% set footer_content = page.find('/' ~ firstfolderofpath ~ '/footer').content %}
  {% if footer_content == empty %}
    {% set footer_content = page.find('/footer').content %}
  {% endif %}
{% elseif page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath).template == 'course' or  page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath).template == 'subsite' %}
  {% set favicon = page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath ~ '/favicon' ).media.images|first %}
  {% if favicon is empty %}
    {% set favicon = page.find('/' ~ firstfolderofpath ~ '/favicon' ).media.images|first %}
  {% endif %}
  {% set site_title = page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath).header.course_site_title %}
  {% if site_title is empty %}
    {% set site_title = page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath).header.subsite_site_title %}
  {% endif %}
  {% if site_title is empty %}
    {% set site_title = page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath).title %}
  {% endif %}
  {% set footer_content = page.find('/' ~ firstfolderofpath ~ '/' ~ secondfolderofpath ~ '/footer').content %}
  {% if footer_content == empty %}
    {% set footer_content = page.find('/footer').content %}
  {% endif %}
{% else %}
  {% set favicon = page.find('/favicon' ).media.images|first %}
  {% set site_title = site.title|e('html') %}
  {% set footer_content = page.find('/footer').content %}
{% endif %}

{% if favicon == empty %}
  {% set favicon = page.find('/favicon' ).media.images|first %}
    {% if favicon == empty %}
      {% set favicon_url = 'theme://images/favicon.png' %}
    {% else %}
      {% set favicon_url = favicon.url %}
    {% endif %}
{% else %}
  {% set favicon_url = favicon.url %}
{% endif %}

<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
    <head>
        {% block head %}
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        {% include 'partials/metadata.html.twig' %}

        <title>{% if header.title %}{{ header.title|e('html') }} | {% endif %}{{ site_title }}</title>
        <link rel="icon" type="image/png" href="{{ url(favicon_url,true) }}" />

        {% block stylesheets %}
            {# load theme.css and custom.css files - hibbittsdesign.org #}
            {% do assets.addCss('theme://css/bootstrap/bootstrap.min.css') %}
            {% do assets.add('theme://css/font-awesome.min.css') %}
            {% do assets.add('theme://css-compiled/theme.css') %}
            {# callout styles for GitHub-style alerts and the course content shortcodes - hibbittsdesign.org #}
            {% do assets.addCss('theme://css/github-alerts.css') %}
            {% set active_theme_css = theme_var('theme_css') ?: '2025' %}
            {# "2026 Modern" is the 2026 Refresh style plus a few modern touches, kept in their own files and loaded after it #}
            {% set modern_touches = false %}
            {% if active_theme_css == '2026-modern' %}
              {% set active_theme_css = '2026' %}
              {% set modern_touches = true %}
            {% endif %}
            {% do assets.addCss('theme://css/theme-' ~ active_theme_css ~ '.css') %}
            {% do assets.addCss('theme://css/open-matter.css') %}
            {# (after open-matter.css, so its rounded bar for the current page replaces the underline there) #}
            {% if modern_touches %}
              {% do assets.addCss('theme://css/theme-2026-modern.css') %}
            {% endif %}
            {% if theme_var('dark_mode.mode') == 'enabled' %}
              {% do assets.addCss('theme://css/theme-' ~ active_theme_css ~ '-dark.css') %}
              {% if modern_touches %}
                {% do assets.addCss('theme://css/theme-2026-modern-dark.css') %}
              {% endif %}
            {% elseif theme_var('dark_mode.mode') == 'auto' and not config.system.assets.css_pipeline %}
              {% do assets.addCss('theme://css/theme-' ~ active_theme_css ~ '-dark.css', {media: '(prefers-color-scheme: dark)'}) %}
              {% if modern_touches %}
                {% do assets.addCss('theme://css/theme-2026-modern-dark.css', {media: '(prefers-color-scheme: dark)'}) %}
              {% endif %}
            {% endif %}
            {% do assets.addCss('theme://css/print.css') %}
            {% do assets.addCss('theme://css/custom.css') %}

            {% if (embedded_mode or theme_var('chromeless.enabled')) %}
              {% do assets.addInlineCss('.chromeless-show{display:block}.chromeless-hide{display:none}') %}
            {% endif %}
        {% endblock %}

        {% block javascripts %}
            {# load jQuery, falling back to Grav's bundled jQuery 3 when a site's configured jQuery file no longer exists (e.g. jquery-2.1.4.min.js, removed in Grav 2.0.14) - hibbittsdesign.org #}
            {% set jquery_asset = config.system.assets.collections.jquery %}
            {% if jquery_asset is iterable or (jquery_asset and url(jquery_asset)) %}
                {% do assets.add('jquery', 102) %}
            {% else %}
                {% do assets.add('system://assets/jquery/jquery-3.x.min.js', 102) %}
            {% endif %}
            {% do assets.add('theme://js/bootstrap.min.js', 101) %}
            {% do assets.add('theme://js/modernizr-custom.js', 100) %}
            {% do assets.add('theme://js/site.js', {group:'bottom'}) %}
            {# load custom js - hibbittsdesign.org #}
            {% do assets.addJs('theme://js/my.js', 99) %}

            {% if browser.getBrowser == 'msie' and browser.getVersion >= 8 and browser.getVersion <= 9 %}
                {% do assets.add('https://oss.maxcdn.com/respond/1.4.2/respond.min.js') %}
                {% do assets.add('theme://js/html5shiv-printshiv.min.js') %}
            {% endif %}
        {% endblock %}

        {% block assets deferred %}
            {{ assets.css()|raw }}
            {% if theme_var('dark_mode.mode') == 'auto' and config.system.assets.css_pipeline %}
              {% set dark_theme_css = theme_var('theme_css') ?: '2025' %}
              {# "2026 Modern" uses the 2026 Refresh dark colours, plus its own (as in the stylesheets above) #}
              {% if dark_theme_css == '2026-modern' %}
                {% set dark_theme_css = '2026' %}
              {% endif %}
              <link rel="stylesheet" href="{{ url('theme://css/theme-' ~ dark_theme_css ~ '-dark.css') }}" media="(prefers-color-scheme: dark)">
              {% if theme_var('theme_css') == '2026-modern' %}
                <link rel="stylesheet" href="{{ url('theme://css/theme-2026-modern-dark.css') }}" media="(prefers-color-scheme: dark)">
              {% endif %}
            {% endif %}
            {{ assets.js()|raw }}
        {% endblock %}

        {% endblock head %}
    </head>

    <body class="{% block body_classes %}{{ page.header.body_classes }}{% if embedded_mode or (theme_var('chromeless.enabled')) %} chromeless{% endif %}{% endblock %}">

        {# check content display flag - hibbittsdesign.org #}
        {% if not embedded_mode and not(theme_var('chromeless.enabled')) %}

          {% if config.plugins.langswitcher.enabled %}
              {% include 'partials/langswitcher.html.twig' %}
          {% endif %}

          {% block header_navigation %}
              {% include 'partials/navigation.html.twig' %}
          {% endblock %}
        {% endif %}

        {% block content %}{% endblock %}
        {% block pagination %}{% endblock %}

        {% if not embedded_mode and not(theme_var('chromeless.enabled')) %}
          <div class="footer">
              <div class="container">
                {% if page.find('/footer').header.footer_scroll %}
                  {# added top of page navigation element - hibbittsdesign.org #}
                  <div class="up-arrow">
                    <a href="#" id="top" title="Top of Page">
                      <i class="fa fa-angle-up" aria-hidden="true"></i>
                    </a>
                  </div>
                {% endif %}
                {# use footer folder page for content - hibbittsdesign.org #}
                <div class="text-muted">
                  {% if (page.header.git_sync_repo_link_display is defined and page.header.git_sync_repo_link_display == 'footer' ) or (( theme_var('display_of_git_sync_repo_link') == 'footer' and page.header.git_sync_repo_link_display is not defined ) and not (page.header.hide_git_sync_repo_link)) %}
                    {# include() gets the link first, so this line is only added when there is one #}
                    {% set git_sync_link = include('partials/git_sync_repo_link.html.twig') %}
                    {% if git_sync_link|trim %}
                      <p>{{ git_sync_link|raw }}</p>
                    {% endif %}
                  {% endif %}
                  {% if theme_var('git_sync_edit_theme_link_location') == 'footer' %}
                    {# include() gets the link first, so this line is only added when there is one #}
                    {% set git_sync_theme_link = include('partials/git_sync_theme_link.html.twig') %}
                    {% if git_sync_theme_link|trim %}
                      <p>{{ git_sync_theme_link|raw }}</p>
                    {% endif %}
                  {% endif %}
                  {% if footer_content %}
                    {{ footer_content|raw }}
                  {% endif %}
                  </div>
              </div>
          </div>
        {% endif %}

        <script async charset="utf-8" src="//cdn.embedly.com/widgets/platform.js"></script>

        {% block bottom %}
            {{ assets.js('bottom')|raw }}
        {% endblock %}

        {# added global scripts - hibbittsdesign.org #}
        {% include 'partials/scripts.html.twig' %}

    </body>
</html>
