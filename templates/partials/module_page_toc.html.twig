{# "On this page": a list of the page's headings, shown on the right of a module page.
   It uses toc_items() from the Page TOC plugin, so module_page.html.twig only includes this
   file when that plugin is enabled (on a site without it, Grav couldn't read this file).
   Like Helios Course Hub, a page can set navigation: toc_position: hidden to turn it off,
   or right to always show it - hibbittsdesign.org #}

{# Step 1: the page's setting, if it has one (right or hidden) #}
{% set toc_position = '' %}
{% if page.header.navigation.toc_position is defined %}
  {% set toc_position = page.header.navigation.toc_position %}
{% endif %}

{% if toc_position != 'hidden' %}

  {# Step 2: the page's headings (h2 and h3; the page title is the only h1) #}
  {% set toc_headings = toc_items(page.content, 2, 2) %}

  {# Step 3: count them, so a short page doesn't get a list with only one or two links #}
  {% set heading_count = 0 %}
  {% for heading in toc_headings.children %}
    {% set heading_count = heading_count + 1 + heading.children|length %}
  {% endfor %}

  {% set show_toc = false %}
  {% if heading_count >= 3 %}
    {% set show_toc = true %}
  {% endif %}
  {% if toc_position == 'right' and heading_count > 0 %}
    {% set show_toc = true %}
  {% endif %}

  {% if show_toc %}
    {# the links use their own class rather than Bootstrap's nav-link, so they get the
       Theme Style's link colour, including in Dark Mode #}
    <nav class="module-toc" aria-label="On this page">
      <p class="module-toc-title">On this page</p>
      <ul class="nav flex-column">
        {% for heading in toc_headings.children %}
          <li class="nav-item">
            {# a heading can be empty when a page skips a level (an h3 with no h2 above it) #}
            {% if heading.uri %}
              <a class="module-toc-link" href="{{ heading.uri }}">{{ heading.label|striptags }}</a>
            {% endif %}
            {% if heading.children|length > 0 %}
              <ul class="nav flex-column module-toc-subheadings">
                {% for subheading in heading.children %}
                  <li class="nav-item">
                    <a class="module-toc-link" href="{{ subheading.uri }}">{{ subheading.label|striptags }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

{% endif %}
