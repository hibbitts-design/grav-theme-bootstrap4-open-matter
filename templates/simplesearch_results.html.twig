{# SimpleSearch results, in the current course's layout, grouped by section with the best matches first and
   the search words highlighted (as in Helios Course Hub) - hibbittsdesign.org #}
{% embed 'partials/base.html.twig' %}

  {% block content %}
    {% do assets.addCss('theme://css/search.css') %}
    <div class="main-content">
      <div class="container">
        <div class="row">
          {% if not (embedded_mode or theme_var('chromeless.enabled')) %}
            <div class="col-md-8 blog-main">
          {% else %}
            <div class="col-md-12 blog-main">
          {% endif %}
            <h1>{{ 'PLUGIN_SIMPLESEARCH.SEARCH_RESULTS'|t }}</h1>

            {% if query %}
              {% set search_groups = open_matter_search_groups(search_results, query) %}
              {% set count = 0 %}
              {% for group in search_groups %}{% set count = count + group.items|length %}{% endfor %}
              {% set search_course = search_course_route ? page.find(search_course_route) : null %}
              {% set search_course_title = search_course ? (search_course.header.subsite_list_title ?: search_course.title) : '' %}

              {# announced to screen readers when the page loads #}
              <p class="search-summary" role="status">
                {% if count is same as(1) %}
                  {{ 'PLUGIN_SIMPLESEARCH.SEARCH_RESULTS_SUMMARY_SINGULAR'|t(query|e)|raw }}
                {% else %}
                  {{ 'PLUGIN_SIMPLESEARCH.SEARCH_RESULTS_SUMMARY_PLURAL'|t(query|e, count)|raw }}
                {% endif %}
                {% if search_course_title %}{{ 'THEME_BOOTSTRAP4_OPEN_MATTER.SEARCH_IN_COURSE'|t(search_course_title|e)|raw }}{% endif %}
              </p>

              {% for group in search_groups %}
                <section class="search-group" aria-labelledby="search-group-{{ loop.index }}">
                  <h2 class="search-group-title" id="search-group-{{ loop.index }}">{{ group.title }}</h2>
                  <div class="card search-results">
                    <div class="list-group list-group-flush">
                      {% for item in group.items %}
                        <a class="list-group-item list-group-item-action search-result" href="{{ item.url }}">
                          <span class="search-result-body">
                            <h3 class="search-result-title">{{ item.title_html|raw }}</h3>
                            {% if item.trail %}<span class="search-result-trail">{{ item.trail }}</span>{% endif %}
                            {% if item.snippet_html %}<span class="search-result-snippet">{{ item.snippet_html|raw }}</span>{% endif %}
                          </span>
                          <span class="search-result-arrow" aria-hidden="true">&rarr;</span>
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                </section>
              {% endfor %}

              {% if count == 0 %}
                <div class="search-no-results">
                  <p>{{ 'THEME_BOOTSTRAP4_OPEN_MATTER.SEARCH_NO_RESULTS_TIPS'|t }}</p>
                  <ul>
                    <li>{{ 'THEME_BOOTSTRAP4_OPEN_MATTER.SEARCH_TIP_SPELLING'|t }}</li>
                    <li>{{ 'THEME_BOOTSTRAP4_OPEN_MATTER.SEARCH_TIP_FEWER_WORDS'|t }}</li>
                  </ul>
                  {% if search_course_route %}
                    <p><a href="{{ base_url_relative ~ (search_route ?? '/search') }}?query={{ query|url_encode }}">{{ 'THEME_BOOTSTRAP4_OPEN_MATTER.SEARCH_ALL_COURSES'|t }}</a></p>
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          </div>
          {% if not (embedded_mode or theme_var('chromeless.enabled')) %}
            <div class="col-md-4 blog-sidebar">
              {% include 'partials/sidebar.html.twig' with {'blog': page} %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endblock %}

{% endembed %}
