{% if page.header.hero_image %}
  {% set header_image_media = page.media.images[page.header.hero_image] %}
{% else %}
  {% set header_image_media = page.media.images | first %}
{% endif %}

{% if header.card_width is defined %}
  {% set card_width = header.card_width %}
{% else %}
  {% set card_width = 3 %}
{% endif %}
{# map the Card Width setting (3, 5 or 12 = 3, 2 or 1 cards per row) to grid columns - hibbittsdesign.org #}
{% set card_cols = {3: 'col-md-6 col-lg-4', 5: 'col-md-6', 12: 'col-12'}[card_width] ?? ('col-lg-' ~ card_width) %}

{% if page.header.show_sidebar is defined %}
  {% set show_sidebar = page.header.show_sidebar %}
{% else %}
  {% set show_sidebar = true %}
{% endif %}

{% embed 'partials/base.html.twig' %}

  {% block content %}

    {# check content display flag - hibbittsdesign.org #}
    {% if not embedded_mode and not(theme_var('chromeless.enabled')) %}
      {# check for hero image - hibbittsdesign.org #}
      {% if header_image_media is not empty %}
        {% include 'partials/hero.html.twig' %}
      {% endif %}
    {% endif %}

    <div class="main-content">
      <div class="container">
        <div class="row">
          {# check content display flag - hibbittsdesign.org #}
          {% if not embedded_mode and not(theme_var('chromeless.enabled')) and (show_sidebar) %}
            <div class="col-md-8 blog-main">
            {% else %}
              <div class="col-md-12 blog-main">
              {% endif %}

              {% if not(page.header.hide_page_title) and not(grav.uri.param('hidepagetitle')) %}
                <h1>{{page.title}}</h1>
              {% else %}
                <h1 class="hidden">{{page.title}}</h1>
              {% endif %}

              {{ page.content|raw }}

              {% do assets.addCss('theme://css/course-cards.css') %}
              <div class="row course-cards">

                {% set siblings = page.collection({items: '@self.siblings','order': {'by': page.header.content.order.by, 'dir': page.header.content.order.dir}}) %}
                {# a course is a Subsite page (subsite.md) or, as in Grav Helios Course Hub, a Course page (course.md) - hibbittsdesign.org #}
                {# courses with a group label (group: "Label", as in Grav Helios Course Hub) are shown after the others, under their group heading - hibbittsdesign.org #}
                {% set course_groups = [] %}
                {% for course in siblings %}
                  {# Added check for hiding post in list - hibbittsdesign.org #}
                  {% if course.header.hide_from_subsite_list != true and (course.template in ['subsite', 'course']) %}
                    {% if course.header.group %}
                      {% if course.header.group not in course_groups %}
                        {% set course_groups = course_groups|merge([course.header.group]) %}
                      {% endif %}
                    {% else %}
                      {% include 'partials/course_card.html.twig' with {course: course, default_home: config.system.home.alias|trim('/')} %}
                    {% endif %}
                  {% elseif course.header.hide_from_subsite_list != true and (course.template == 'subsitegroup') %}
                    <div class="col-12">
                      <h3 class="course-group-title">{{ course.header.title }}</h3>
                    </div>
                    {% set children = course.collection({'items': {'@page.children': course.route}}) %}
                    {% for p in children %}
                      {% if p.header.hide_from_subsite_list != true and (p.template in ['subsite', 'course']) %}
                        {% include 'partials/course_card.html.twig' with {course: p, default_home: 'home', fallback_title: p.header.subsite_site_title} %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endfor %}
                {% for course_group in course_groups %}
                  <div class="col-12">
                    <h3 class="course-group-title">{{ course_group }}</h3>
                  </div>
                  {% for course in siblings %}
                    {% if course.header.hide_from_subsite_list != true and (course.template in ['subsite', 'course']) and course.header.group == course_group %}
                      {% include 'partials/course_card.html.twig' with {course: course, default_home: config.system.home.alias|trim('/')} %}
                    {% endif %}
                  {% endfor %}
                {% endfor %}

              </div>

              {# Creative Commons License -  hibbittsdesign.org #}
              {% if not embedded_mode and not(theme_var('chromeless.enabled')) and (theme_var('cc_license.enabled') and not(page.header.hide_cc_license)) %}
                <p>{% include 'partials/creative_commons_license.html.twig' %}</p>
              {% endif %}
              {# Git repository edit link -  hibbittsdesign.org #}
              {% if ( page.header.git_sync_repo_link_display is defined and page.header.git_sync_repo_link_display == 'page' ) or (( theme_var('display_of_git_sync_repo_link') == 'page' and page.header.git_sync_repo_link_display is not defined ) and not (page.header.hide_git_sync_repo_link)) %}
                  <p>{% include 'partials/git_sync_repo_link_note.html.twig' %}</p>
              {% endif %}

            </div>

            {# Check content display flag - hibbittsdesign.org #}
            {% if not embedded_mode and not(theme_var('chromeless.enabled')) and (show_sidebar) %}
              <div class="col-md-4 blog-sidebar">
                {% include 'partials/sidebar.html.twig' with {
                  'blog' : page
                } %}
              </div>
            {% endif %}

          </div>
        </div>
      </div>
    {% endblock %}

  {% endembed %}
